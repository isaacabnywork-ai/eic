# ==========================================
# Equip Indian Churches - Environment Configuration
# ==========================================

# [REQUIRED] WordPress Backend URL
# The root URL of the WordPress installation where JetEngine and REST API are hosted.
# Do NOT add a trailing slash.
VITE_WP_URL=https://equipindianchurches.com

# [REQUIRED IN PRODUCTION] Frontend Public URL
# The domain where this React frontend is deployed (used for Canonical links, OG tags, and Sitemap).
# E.g. https://equipindianchurches.com or https://your-site.vercel.app
VITE_SITE_URL=https://equipindianchurches.com

# [OPTIONAL] Mock Data Mode
# Set to 'true' to use built-in offline dummy data instead of fetching live WordPress REST API.
# Default: false
VITE_USE_MOCK=false

# [OPTIONAL] Feature Flag: Church Directory
# Set to 'true' to enable the /churches directory page.
# Default: false (Directorist / church directory remains hidden)
VITE_ENABLE_CHURCH_DIRECTORY=false

# [OPTIONAL] Newsletter Integration
# Provide a Mailchimp, ConvertKit, or custom webhook URL if connecting external newsletter form.
# If omitted, the UI provides a friendly simulated confirmation.
VITE_NEWSLETTER_ACTION_URL=
VITE_NEWSLETTER_EMAIL_FIELD=email

# [OPTIONAL] Contact & Support Email
VITE_CONTACT_EMAIL=contact@equipindianchurches.com

# [OPTIONAL] Social Media Profile Links
VITE_SOCIAL_YOUTUBE=https://youtube.com
VITE_SOCIAL_FACEBOOK=https://facebook.com
VITE_SOCIAL_INSTAGRAM=https://instagram.com
VITE_SOCIAL_X=https://x.com
